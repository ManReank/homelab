<network>
  <name>lab-net</name>

  <forward mode='nat'/>

  <bridge
      name='virbr-lab'
      stp='on'
      delay='0'/>

  <ip
      address='192.168.100.1'
      netmask='255.255.255.0'>

    <dhcp>
      <range
          start='192.168.100.100'
          end='192.168.100.254'/>
    </dhcp>

  </ip>
</network>
